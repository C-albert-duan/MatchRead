# Copy to `.env.docker` (gitignored). Used by docker compose --env-file .env.docker
# Docker-only workflow — no host npm install. See docs/DOCKER.md.
# Never put SUPABASE_SERVICE_ROLE_KEY here for the web service.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: founder gate for /founder (comma-separated)
# FOUNDER_EMAILS=you@example.com

# Host port mapped to the web container
WEB_PORT=3001

# Only for `docker compose --profile migrate run --rm migrate`
# Prefer the Supabase pooler URI (Transaction or Session mode). Do not commit real passwords.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
