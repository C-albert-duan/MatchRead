# Copy to apps/web/.env.local for local development.
# Never commit real values. Never put SUPABASE_SERVICE_ROLE_KEY here for the web app.
# See docs/ENVIRONMENT-VARIABLES.md and docs/AUTH.md

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Local — match the port used by `npm run dev` (currently 3001).
# Omit on Vercel Preview (uses VERCEL_URL). Set on Production to the canonical domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Comma-separated founder emails for /founder routes (server-only).
# If unset, any signed-in user can open founder tools (beta banner shown).
# FOUNDER_EMAILS=you@example.com
