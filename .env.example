# Prefer `.env.docker` for Compose (Docker-only workflow). See docs/DOCKER.md.
# Optional: apps/web/.env.local is unused by Docker; do not rely on it.
# Never commit real values. Never put SUPABASE_SERVICE_ROLE_KEY here for the web app.
# See docs/ENVIRONMENT-VARIABLES.md and docs/AUTH.md

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Local — match the port used by Compose (currently 3001).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Comma-separated founder emails for /founder routes (server-only).
# If unset, any signed-in user can open founder tools (beta banner shown).
# FOUNDER_EMAILS=you@example.com
