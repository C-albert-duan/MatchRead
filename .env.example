# Prefer `.env.docker` for Compose (Docker-only workflow). See architecture/infrastructure/ci-and-deploy.md.
# Optional: apps/web/.env.local is unused by Docker; do not rely on it.
# Never commit real values. Never put SUPABASE_SERVICE_ROLE_KEY here for the web app.
# See architecture/infrastructure/environment.md

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Local — match the port used by Compose (currently 3001).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Comma-separated founder emails for /founder routes (server-only).
# If unset, any signed-in user can open founder tools (beta banner shown).
# FOUNDER_EMAILS=you@example.com

# Optional error reporting. Leave unset locally; the app runs without a DSN.
# Server: SENTRY_DSN. Browser: NEXT_PUBLIC_SENTRY_DSN (inlined at build).
# Source maps upload only when all three upload vars are set.
# Edge functions read SENTRY_DSN from Supabase secrets, not from this file.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# League schedule editing for commissioners (server-only). Off unless "1".
# MATCHREAD_CUSTOM_SCHEDULE=1
