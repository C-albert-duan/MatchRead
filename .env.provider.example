# Copy to `.env.provider` (gitignored). Local ops scripts only — not the web app.
# Production: `npx supabase secrets set RAPIDAPI_KEY=...` and deploy sync-facts.
# See architecture/infrastructure/environment.md and architecture/infrastructure/ops-scripts.md.
# Never put these on Vercel or GitHub. Never commit real values.

RAPIDAPI_KEY=<your-rapidapi-key>
RAPIDAPI_HOST=tennis-api-atp-wta-itf.p.rapidapi.com

# Required for live publish / reconcile (not needed for --dry-run).
# Legacy URLs ending in /ingest-events or /rebuild-draw are rewritten to /sync-facts by scripts.
# MATCHREAD_INGEST_URL=https://<project-ref>.supabase.co/functions/v1/sync-facts
# INGEST_SECRET=<same-as-supabase-secrets>
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon>
