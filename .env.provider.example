# Copy to `.env.provider` (gitignored). Local scripts + apps/worker only.
# Production key: `npx supabase secrets set RAPIDAPI_KEY=...` (see docs/runbooks/SYNC-TENNIS.md).
# Never put these on Vercel or GitHub. Never commit real values.

RAPIDAPI_KEY=<your-rapidapi-key>
RAPIDAPI_HOST=tennis-api-atp-wta-itf.p.rapidapi.com

# Required for live worker / reconcile / publish:draws (not needed for --dry-run)
# MATCHREAD_INGEST_URL=https://<project-ref>.supabase.co/functions/v1/ingest-events
# INGEST_SECRET=<same-as-supabase-secrets>
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon>
#
# Worker poll (defaults: publish 15m, reconcile 60s + Mega live socket)
# WORKER_PUBLISH_MS=900000
# WORKER_RECONCILE_MS=60000
# PORT=8080
# Optional: local SERVICE_ROLE not required — rebuild-draw Edge Function uses platform service role.
