{
  "name": "matchread",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @matchread/web",
    "build": "npm run build -w @matchread/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:settlement": "node scripts/verify-settlement-math.mjs",
    "probe:rapidapi": "node scripts/probe-rapidapi.mjs",
    "reconcile:results": "node scripts/reconcile-results.mjs",
    "import:montreal-draw": "node scripts/import-montreal-draw.mjs",
    "import:nbo-draw": "node scripts/import-nbo-draw.mjs",
    "sync:lock-at": "node scripts/sync-lock-at.mjs",
    "test:provider": "npm run test -w @matchread/provider-rapidapi"
  }
}
